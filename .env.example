# --- Telegram Bot ---
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Telegram ID администраторов (через запятую): ID можно узнать у @userinfobot
ADMIN_IDS=123456789

# --- Реклама (показывается перед скачиванием) ---
# ВАЖНО: значения должны быть в одну строку (без переносов и пустых строк внутри)
AD_TEXT=🔥 Этот бот работает полностью бесплатно благодаря рекламе! Пожалуйста, поддержите проект — перейдите к рекламодателю по кнопке ниже. Так вы помогаете развитию бота и получаете видео бесплатно 💛
AD_LINK=https://example.com
AD_BUTTON_LABEL=👉 Перейти к рекламодателю
# Как часто показывать рекламу одному пользователю (в часах). 0 = каждый раз.
AD_COOLDOWN_HOURS=0

# --- Поддержка автора ---
SUPPORT_URL=https://example.com/donate
SUPPORT_TEXT=Спасибо, что пользуетесь ботом! 💛

# --- Файлы ---
# Максимальный размер обрабатываемого вето (байты). По умолчанию 2 ГБ.
MAX_FILE_SIZE=2147483648
DOWNLOAD_DIR=downloads
FFMPEG_PATH=ffmpeg
YTDLP_PATH=yt-dlp

# --- Режим работы ---
# Для Railway 24/7 с webhook: USE_WEBHOOK=true, USE_LONG_POLLING=false, PUBLIC_URL=https://мой-домен.up.railway.app
# Для локального запуска: оставьте USE_WEBHOOK=false, USE_LONG_POLLING=true (default)
USE_WEBHOOK=false
USE_LONG_POLLING=true
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=
PUBLIC_URL=https://your-app.up.railway.app

# --- FastAPI / Uvicorn ---
# PORT задаётся автоматически на Railway. Для локального запуска — 8000.
APP_HOST=0.0.0.0
APP_PORT=8000

# --- База данных ---
DATABASE_PATH=bot.db